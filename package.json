{
  "name": "react-wordgard",
  "version": "0.0.0",
  "private": true,
  "description": "A React view for the Wordgard rich text editor",
  "author": "Edoardo Caratti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/react-wordgard.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "README.md",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "check:types": "tsc",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:bench": "tsc -p bench",
    "fix": "eslint --fix . && prettier --write .",
    "demo": "vite",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "vitest run --config bench/vitest.config.ts",
    "bench:dev": "vitest run --config bench/vitest.config.ts --mode development",
    "bench:smoke": "vitest run --config bench/vitest.config.ts --mode smoke",
    "bench:heap": "vitest run --config bench/vitest.config.ts --mode heap",
    "bench:heap-dev": "vitest run --config bench/vitest.config.ts --mode heap-development",
    "bench:profile": "vitest run --config bench/vitest.config.ts --mode profile",
    "bench:profile-dev": "vitest run --config bench/vitest.config.ts --mode profile-development",
    "sync-wordgard-tests": "node scripts/sync-wordgard-tests.js",
    "update-wordgard": "node scripts/update-wordgard.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "ist": "^1.1.7",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "use-sync-external-store": "^1.7.0",
    "wordgard": "0.6.2"
  }
}
