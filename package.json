{
  "name": "react-wordgard",
  "version": "0.0.0",
  "private": true,
  "description": "A React view for the Wordgard rich text editor",
  "author": "Edoardo Caratti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/react-wordgard.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "README.md",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "check:types": "tsc",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "demo": "vite",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "sync-wordgard-tests": "node scripts/sync-wordgard-tests.js",
    "update-wordgard": "node scripts/update-wordgard.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-reconciler": "^0.28.9",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "ist": "^1.1.7",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.8",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-test-builder": "^1.1.1",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "1.42.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-reconciler": "^0.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "prosemirror-model": "^1.0.0",
    "prosemirror-state": "^1.0.0",
    "prosemirror-transform": "^1.8.0",
    "prosemirror-view": "1.42.3",
    "react": ">=17 <20",
    "react-dom": ">=17 <20",
    "react-reconciler": ">=0.26.1 <=0.33.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "wordgard": "0.6.2"
  },
  "overrides": {
    "prosemirror-view": "1.42.3"
  }
}
