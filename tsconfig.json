{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  // The packages type-check themselves (turbo run typecheck); this is the rest.
  "include": ["demo", "test/*.ts", "test/view-svelte/build.test.ts", "*.ts"],
  // svelte-check reads the Svelte demo's components (demo/svelte/tsconfig.json).
  "exclude": ["demo/svelte"]
}
