{
  "name": "@stesura/vue-wordgard",
  "version": "0.3.0",
  "description": "A Vue view for the Wordgard rich text editor",
  "keywords": [
    "vue",
    "wordgard",
    "rich-text",
    "editor",
    "contenteditable"
  ],
  "homepage": "https://github.com/stesura/react-wordgard/tree/master/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/stesura/react-wordgard/issues"
  },
  "author": "Edoardo Caratti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/react-wordgard.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@stesura/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-dts",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup && node ../../scripts/copy-skill-reference.js vue"
  },
  "dependencies": {
    "@stesura/wordgard-view": "0.3.0"
  },
  "peerDependencies": {
    "vue": "~3.5.45",
    "wordgard": "0.7.0"
  }
}
