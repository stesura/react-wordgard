{
  "name": "@stesura/wordgard-view",
  "version": "0.3.0",
  "description": "The core of react-wordgard and vue-wordgard, not for direct use",
  "keywords": [
    "wordgard"
  ],
  "homepage": "https://github.com/stesura/react-wordgard/tree/master/packages/core#readme",
  "bugs": {
    "url": "https://github.com/stesura/react-wordgard/issues"
  },
  "author": "Edoardo Caratti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/react-wordgard.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@stesura/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-dts",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "peerDependencies": {
    "wordgard": "0.7.0"
  }
}
