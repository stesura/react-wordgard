{
  "name": "@stesura/svelte-wordgard",
  "version": "0.3.0",
  "description": "A Svelte view for the Wordgard rich text editor",
  "keywords": [
    "svelte",
    "wordgard",
    "rich-text",
    "editor",
    "contenteditable"
  ],
  "homepage": "https://github.com/stesura/react-wordgard/tree/master/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/stesura/react-wordgard/issues"
  },
  "author": "Edoardo Caratti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stesura/react-wordgard.git",
    "directory": "packages/svelte"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@stesura/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "THIRD_PARTY_LICENSES.txt",
    "dist",
    "!dist/__tests__",
    "!dist/testing",
    "skills"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "prepack": "svelte-package -i src -o dist && node ../../scripts/copy-skill-reference.js svelte"
  },
  "dependencies": {
    "@stesura/wordgard-view": "0.3.0",
    "esm-env": "^1.2.2"
  },
  "peerDependencies": {
    "svelte": "~5.57.3",
    "wordgard": "0.7.0"
  }
}
